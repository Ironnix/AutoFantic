<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- no console window: AutoFantic lives as an icon next to the clock -->
    <OutputType>WinExe</OutputType>
    <!-- the window is WPF (Windows 11 "Fluent" look); the icon next to the clock is WinForms' NotifyIcon -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF's Fluent theme (ThemeMode) is still marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <RootNamespace>AutoFantic.App</RootNamespace>
    <AssemblyName>AutoFantic</AssemblyName>
    <!-- one self-contained exe, like the test tool -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoFantic.Core\AutoFantic.Core.csproj" />
  </ItemGroup>

</Project>
