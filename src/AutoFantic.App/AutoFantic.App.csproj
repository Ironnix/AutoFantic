<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- no console window: AuFantic lives as an icon next to the clock -->
    <OutputType>WinExe</OutputType>
    <!-- the window is WPF (Windows 11 "Fluent" look); the icon next to the clock is WinForms' NotifyIcon -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF's Fluent theme (ThemeMode) is still marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <RootNamespace>AutoFantic.App</RootNamespace>
    <AssemblyName>AutoFantic</AssemblyName>
    <!-- what Task Manager and the file's properties call it: the new name (the file itself keeps the old one) -->
    <AssemblyTitle>AuFantic</AssemblyTitle>
    <!-- the logo (assets\logo.svg at 16 to 256 pixels): the exe's icon, which the window and the taskbar show too -->
    <ApplicationIcon>AuFantic.ico</ApplicationIcon>
    <!-- one self-contained exe, like the test tool -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- not compressed: a compressed exe is half the size, but unpacks into about 80 MB of RAM -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoFantic.Core\AutoFantic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the German texts (see Texts.cs): English text → German text -->
    <EmbeddedResource Include="Lang\*.json" />
  </ItemGroup>

</Project>
