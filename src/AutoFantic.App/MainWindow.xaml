<Window x:Class="AutoFantic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoFantic.App"
        Title="AuFantic" Width="1120" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="6" Padding="16,10" Margin="0,2" Background="Transparent">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal">
                                    <!-- the tab's icon: a glyph of Windows' own icon font (Windows 11, else Windows 10's), given as the button's Tag -->
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               Width="20" TextAlignment="Center" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- presets and fan chips: toggles shaped like cards -->
        <Style x:Key="Choice" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- sidebar (no logo or name here: the title bar right above has both) -->
        <DockPanel Grid.Column="0" Margin="16,24,8,16">
            <TextBlock x:Name="SideStatus" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="6,10,6,0" />
            <!-- at the bottom: what is set up once or looked up now and then -->
            <StackPanel DockPanel.Dock="Bottom">
                <RadioButton x:Name="NavCalibration" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xEC4A;" Content="Calibration" />
                <RadioButton x:Name="NavLog" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE81C;" Content="Log" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE713;" Content="Settings" />
            </StackPanel>
            <!-- at the top: what is looked at every day -->
            <StackPanel>
                <RadioButton x:Name="NavOverview" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE80F;" IsChecked="True" Content="Overview" />
                <RadioButton x:Name="NavMonitor" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE9D9;" Content="Monitor" />
                <RadioButton x:Name="NavCurves" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE9D2;" Content="Fan curves" />
                <RadioButton x:Name="NavReports" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE9F9;" Content="Reports" />
                <RadioButton x:Name="NavHealth" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE95E;" Content="Cooling health" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Column="1" Margin="12,24,24,20">

            <!-- overview -->
            <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource Heading}" />

                    <!-- what the start-up checks found that needs a look (another fan program, a missing driver) -->
                    <Border x:Name="NoticeCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="NoticeRows" />
                            <Button x:Name="NoticeRecheck" Grid.Column="1" Content="Check again" Padding="14,6" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StateDot" Width="18" Height="18" Fill="#1baf7a" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="StateTitle" Text="AuFantic controls your fans" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="StateDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="PauseButton" Grid.Column="2" Content="Pause" MinWidth="130" Padding="18,9" VerticalAlignment="Center"
                                    Style="{DynamicResource AccentButtonStyle}" />
                        </Grid>
                    </Border>

                    <UniformGrid Columns="3" Margin="-6,0,-6,6">
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="CpuTemp" Text="–" FontSize="34" FontWeight="SemiBold" />
                                <TextBlock x:Name="CpuPower" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="Graphics card" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="GpuTemp" Text="–" FontSize="34" FontWeight="SemiBold" />
                                <TextBlock x:Name="GpuPower" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="Preset" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="LimitValue" Text="–" FontSize="34" FontWeight="SemiBold" />
                                <TextBlock x:Name="LimitDetail" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- the graphics card draws far more than it should while the PC is idle: why, and what helps -->
                    <Border x:Name="IdlePowerCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="!" Foreground="#eda100" FontSize="15" FontWeight="Bold" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="IdlePowerTitle" FontSize="14" TextWrapping="Wrap" />
                                <TextBlock x:Name="IdlePowerDetail" Style="{StaticResource Caption}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="IdlePowerDisplays" Content="Open the display settings" Padding="14,6" />
                                    <Button x:Name="IdlePowerHide" Content="Don't show again" Padding="14,6" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Fans" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                            <StackPanel x:Name="FanRows" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="How your PC should sound" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,14"
                                       Text="One setting for all fans. Your own curves stay." />
                            <UniformGrid x:Name="PresetButtons" Columns="4" />
                            <TextBlock x:Name="ProfileNote" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed" />
                            <StackPanel x:Name="QuietPanel" Margin="0,18,0,0">
                                <TextBlock Text="Extra quiet" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10"
                                           Text="Every fan at its slowest, and off where it can stop (the graphics card too), as long as it stays cool." />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox x:Name="QuietAway" Content="When I'm away for" VerticalAlignment="Center" />
                                    <TextBox x:Name="QuietAwayMinutes" Width="52" Margin="8,0,6,0" VerticalContentAlignment="Center" />
                                    <TextBlock Text="min" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="QuietNight" Content="At night, from" VerticalAlignment="Center" />
                                    <TextBox x:Name="QuietFrom" Width="64" Margin="8,0,6,0" VerticalContentAlignment="Center" />
                                    <TextBlock Text="to" VerticalAlignment="Center" />
                                    <TextBox x:Name="QuietTo" Width="64" Margin="6,0,0,0" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- monitor: the history of temperatures, power and fans, and the warnings; the heading and the time ranges stay in view while the charts scroll -->
            <Grid x:Name="MonitorPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Monitor" Style="{StaticResource Heading}" />
                <WrapPanel x:Name="RangeButtons" Grid.Row="1" Margin="0,0,0,4" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Temperatures" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="LimitsNote" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <local:HistoryChart x:Name="TempChart" Height="220" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Power" Style="{StaticResource CardTitle}" />
                            <local:HistoryChart x:Name="PowerChart" Height="180" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Fans" Style="{StaticResource CardTitle}" />
                            <local:HistoryChart x:Name="FanChart" Height="180" Margin="0,8,0,0" />
                            <local:HistoryChart x:Name="RpmChart" Height="180" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- the user's own chart: any lines together, each unit with its own scale -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Compare" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                       Text="Your own chart: pick what you want to see together, for example the GPU memory and the GPU fans. Each unit has its own scale, the first on the left and the second on the right." />
                            <WrapPanel x:Name="CompareChoices" />
                            <local:HistoryChart x:Name="CompareChart" Height="260" Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Values" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="ValuesIntro" Style="{StaticResource Caption}" Margin="0,2,0,12" />
                            <Grid x:Name="ValueRows" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Warnings" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" Text="A message next to the clock and in the Log. The safety limits work on their own." />
                            <CheckBox x:Name="FanStoppedBox" Content="When a fan stands still although it should turn" Margin="0,0,0,10" />
                            <StackPanel x:Name="WarningRows" />
                            <Button x:Name="AddWarning" Content="Add a warning" Padding="14,6" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- reports: game sessions -->
            <ScrollViewer x:Name="ReportsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Reports" Style="{StaticResource Heading}" />
                    <TextBlock x:Name="ReportsNow" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <!-- the week in one line: how long was played, how warm it got, how the cooling does -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="The last 7 days" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="WeekHeadline" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock x:Name="WeekDetail" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="By game" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" Text="Every session: a program that kept the PC busy for at least 3 minutes. Ø = average." />
                            <Grid x:Name="GameRows" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sessions" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                            <Grid x:Name="SessionRows" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- cooling health -->
            <ScrollViewer x:Name="HealthPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Cooling health" Style="{StaticResource Heading}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="HealthDot" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="HealthTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="HealthDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="HealthCalibrate" Grid.Column="2" Content="Calibrate again" Padding="16,9" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Compared with earlier" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="HealthCompareIntro" Style="{StaticResource Caption}" Margin="0,2,0,12" />
                            <Grid x:Name="HealthCompareRows" />
                            <TextBlock x:Name="HealthCompareNote" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Fans" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                       Text="How fast each fan turns at the same setting, against its first week. A worn bearing or dirt makes a fan slower, and often louder. Graphics card fans often hold their speed themselves, so their wear shows late." />
                            <Grid x:Name="FanWearRows" />
                            <local:HistoryChart x:Name="FanWearChart" Height="200" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Over time" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="HealthChartIntro" Style="{StaticResource Caption}" Margin="0,2,0,10" />
                            <WrapPanel x:Name="HealthRangeButtons" />
                            <local:HistoryChart x:Name="HealthChart" Height="240" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Last 7 days" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                       Text="Against what the calibration's model expects at the same power and fan speeds (the model is never exact, so the comparisons above use the first week after the calibration as normal)." />
                            <Grid x:Name="HealthRows" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="How it works" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="AuFantic compares every steady minute (the same power for a while) with what the calibration measured at that power and those fan speeds. A warmer room makes CPU and GPU warmer by the same amount, at any load. Dust in the filters and heatsinks, or old thermal paste, makes them warmer the harder they work. AuFantic tells the two apart, so a hot summer day doesn't look like dust. Every day's result is kept, so you can look back a year and more." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- fan curves -->
            <Grid x:Name="CurvesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Fan curves" Style="{StaticResource Heading}" />
                    <!-- one switch for all curves: the fans go ahead of the temperature when the graphics card's power jumps -->
                    <ToggleButton x:Name="ReactEarlyButton" Grid.Column="1" Style="{StaticResource Choice}" Padding="14,8" VerticalAlignment="Top" Margin="0,4,0,0"
                                  ToolTip="When the graphics card suddenly draws much more power (a game starts, a heavy scene), its fans and the case fans speed up right away instead of waiting for the temperature to rise. Fewer temperature spikes; the fans change speed a little more often.">
                        <TextBlock x:Name="ReactEarlyText" FontSize="14" />
                    </ToggleButton>
                </Grid>
                <WrapPanel x:Name="CurveTabs" Grid.Row="1" Margin="0,0,0,12" />
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CurveTitle" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="CurveSubtitle" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Ellipse Width="10" Height="10" x:Name="LegendUse" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="in use" Style="{StaticResource Caption}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <Rectangle Width="16" Height="2" x:Name="LegendRecommended" Margin="0,0,6,0" VerticalAlignment="Center" StrokeDashArray="2 2" StrokeThickness="2" />
                                <TextBlock Text="recommended" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <local:CurveEditor x:Name="Editor" Grid.Row="1" Margin="0,14" MinHeight="280" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox x:Name="BiosBox" Content="Let the BIOS control these fans" />
                                <TextBlock x:Name="BiosHint" Style="{StaticResource Caption}" Margin="28,2,16,0" TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="AuFantic leaves them alone, also when a temperature limit is crossed: the BIOS's own curve applies. The other fans stay with AuFantic, and this curve is kept for when you switch back." />
                                <CheckBox x:Name="AllowStop" Content="Switch off when the PC is idle and cool" Margin="0,10,0,0" />
                                <TextBlock x:Name="StopHint" Style="{StaticResource Caption}" Margin="28,2,16,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="CurveHint" Style="{StaticResource Caption}" Margin="0,8,16,0"
                                           Text="Drag a point · double-click to add · right-click to remove. Applies right away." />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock x:Name="FallbackText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    <Button x:Name="CopyFallback" Content="Copy" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="ResetCurve" Grid.Column="1" Content="Reset to recommended" Padding="16,9" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- calibration -->
            <ScrollViewer x:Name="CalibrationPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="CalibrationHeading" Text="Calibration" Style="{StaticResource Heading}" />

                    <!-- before the first calibration: what to do, the checks, and step 1 -->
                    <StackPanel x:Name="SetupCards" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Welcome to AuFantic" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="Two steps, about 20 minutes. Until then the BIOS keeps your fans." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Before you start" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <Button x:Name="SetupRecheck" Grid.Column="1" Content="Check again" Padding="14,6" />
                                </Grid>
                                <StackPanel x:Name="SetupChecks" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="FindFansTitle" Text="Step 1 · Find my fans" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="Each fan output runs through a few speeds. About 2 minutes, best while the PC is idle." />
                                <Button x:Name="SetupFindFans" Content="Find my fans" Style="{DynamicResource AccentButtonStyle}" Padding="18,9" MinWidth="170"
                                        HorizontalAlignment="Left" Margin="0,16,0,0" />
                                <StackPanel x:Name="FoundFans" Margin="0,14,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="CalibrateTitle" Text="Calibrate" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="About 15 minutes while your PC works. Each calibration adds to the ones before." />
                            <StackPanel x:Name="CalibrateSetup" Margin="0,16,0,0">
                                <RadioButton x:Name="LoadGame" GroupName="load" IsChecked="True" Margin="0,0,0,6"
                                             Content="My game: start it when asked, then play normally" />
                                <RadioButton x:Name="LoadBuiltIn" GroupName="load"
                                             Content="Built-in load: don't use the PC meanwhile" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="Room temperature" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox x:Name="RoomTemp" Width="64" Text="22" VerticalContentAlignment="Center" />
                                    <TextBlock Text="°C (a guess is fine)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="StartCalibrationButton" Content="Start calibration" Style="{DynamicResource AccentButtonStyle}" Padding="18,9" MinWidth="170" />
                                <Button x:Name="StopCalibrationButton" Content="Stop" Padding="18,9" Margin="10,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel x:Name="CalibrationLive" Visibility="Collapsed" Margin="0,18,0,0">
                                <TextBlock x:Name="CalibrationStatus" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ProgressBar x:Name="CalibrationBar" Height="6" Minimum="0" Maximum="1" Margin="0,10,0,8" />
                                <TextBlock x:Name="CalibrationSpeeds" Style="{StaticResource Caption}" />
                                <local:LiveChart x:Name="CalibrationChart" Height="230" Margin="0,12,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="CalibrationLogText" Style="{StaticResource Caption}" Margin="0,14,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- what a calibration found: only once there is one -->
                    <StackPanel x:Name="InsightCards">
                    <!-- improve from everyday use: the history against the calibration, and the curves that would give -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Improve from everyday use" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="Checks the curves against how the PC really ran since the calibration and suggests better ones. Nothing changes until you say so." />
                            <TextBlock x:Name="UseInUseText" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="AnalyseUseButton" Content="Analyse my use" Style="{DynamicResource AccentButtonStyle}" Padding="18,9" MinWidth="170" />
                                <Button x:Name="DropUseButton" Content="Back to the calibration's curves" Padding="18,9" Margin="10,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel x:Name="UseResult" Margin="0,18,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="UseSummary" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel x:Name="UseFindings" Margin="0,8,0,0" />
                                <StackPanel x:Name="UseCurves" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,10"
                                               Text="Each fan's curve: the suggested one as a solid line, the one in use now dashed." />
                                    <UniformGrid x:Name="UseCharts" Columns="2" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="TakeOverUseButton" Content="Use the new curves" Style="{DynamicResource AccentButtonStyle}" Padding="18,9" MinWidth="170" />
                                        <Button x:Name="DiscardUseButton" Content="Keep the current ones" Padding="18,9" Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Your fans" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,14"
                                       Text="How many fans are on each output, how loud they are and what they cool." />
                            <StackPanel x:Name="LoudnessRows" />
                            <StackPanel x:Name="TogetherRows" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="What each fan cools" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,14"
                                       Text="How much warmer CPU and GPU get with this fan at its slowest instead of 100 %, at full load." />
                            <StackPanel x:Name="EffectRows" />
                        </StackPanel>
                    </Border>

                    <!-- every measurement: a long list, so it's closed until someone wants to see it -->
                    <Expander x:Name="RunsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                                       Text="Every measurement, newest first. Bottleneck = the part closest to its limit." />
                            <StackPanel x:Name="RunRows" />
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- log: what AuFantic did -->
            <Grid x:Name="LogPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Log" Style="{StaticResource Heading}" />
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"
                               Text="What AuFantic did, newest first." />
                    <Button x:Name="OpenLogFile" Grid.Column="1" Content="Open the log file" Padding="16,9" />
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="20,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LogRows" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- settings -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource Heading}" Margin="0" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,16" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="UpdateDailyBox" Grid.Column="1" VerticalAlignment="Center" Content="Check by itself"
                                          ToolTip="At every start and once a day AuFantic asks GitHub for a new version. Nothing about your PC is sent." />
                            </Grid>
                            <ProgressBar x:Name="UpdateProgress" Height="6" Minimum="0" Maximum="1" Margin="0,12,0,0" Visibility="Collapsed" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="UpdateInstall" Style="{DynamicResource AccentButtonStyle}" Padding="16,9" Margin="0,0,10,0" Visibility="Collapsed" />
                                <Button x:Name="UpdateCheckButton" Content="Check for updates" Padding="16,9" Margin="0,0,10,0" />
                                <Button x:Name="UpdateNotes" Content="What's new" Padding="16,9" Visibility="Collapsed" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="AutostartNote" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="Starts when you log in, without an admin prompt." />
                            </StackPanel>
                            <CheckBox x:Name="AutostartBox" Grid.Column="1" VerticalAlignment="Center" Content="On" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="Light or dark. &quot;Like Windows&quot; follows Windows (Settings → Personalization → Colors)." />
                            </StackPanel>
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="160">
                                <ComboBoxItem Content="Like Windows" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                            <StackPanel Grid.Row="1" Margin="0,16,16,0">
                                <TextBlock Text="Language" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="English or German. AuFantic starts again to switch." />
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" MinWidth="160" Margin="0,16,0,0">
                                <ComboBoxItem Content="Like Windows" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Deutsch" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Your data" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="CalibrationInfo" Style="{StaticResource Caption}" Margin="0,2,0,6" />
                            <TextBlock x:Name="DataPath" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                       Text="Every Windows account has its own data folder. To have the same fans, calibration and curves in another account on this PC, choose the same folder in both." />
                            <WrapPanel>
                                <Button x:Name="OpenPage" Content="Open the calibration page" Padding="16,9" Margin="0,0,10,10" />
                                <Button x:Name="OpenFolder" Content="Open the data folder" Padding="16,9" Margin="0,0,10,10" />
                                <Button x:Name="ChangeFolderButton" Content="Change the folder …" Padding="16,9" Margin="0,0,10,10"
                                        ToolTip="AuFantic copies its data to the folder you choose and uses it from then on. If the folder already has a calibration (from another account), that one is used." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Developer" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10"
                                       Text="For testing. Not needed for normal use." />
                            <TextBlock x:Name="SelfUsageText" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <WrapPanel>
                                <Button x:Name="FindFansButton" Content="Find my fans again" Padding="16,9" Margin="0,0,10,10" />
                                <Button x:Name="SensorsButton" Content="Show all sensors" Padding="16,9" Margin="0,0,10,10" />
                                <Button x:Name="ConsoleButton" Content="Open the test console" Padding="16,9" Margin="0,0,10,10" />
                            </WrapPanel>
                            <TextBlock x:Name="DeveloperNote" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Text="The test console closes AuFantic first, so only one program drives the fans." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
