<Window x:Class="AutoFanatic.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoFanatic.Tray"
        Title="AutoFanatic" Width="1080" Height="740" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="6" Padding="16,10" Margin="0,2" Background="Transparent">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- the Max 80 / Max 90 choice and the fan chips: pill-shaped toggles -->
        <Style x:Key="Choice" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <DockPanel Grid.Column="0" Margin="16,24,8,16">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,28">
                <Ellipse x:Name="LogoDot" Width="14" Height="14" Fill="#1baf7a" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="AutoFanatic" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="SideStatus" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="6,0" />
            <StackPanel>
                <RadioButton x:Name="NavOverview" Style="{StaticResource Nav}" GroupName="nav" IsChecked="True" Content="Overview" />
                <RadioButton x:Name="NavCurves" Style="{StaticResource Nav}" GroupName="nav" Content="Fan curves" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="nav" Content="Settings" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Column="1" Margin="12,24,24,20">

            <!-- overview -->
            <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource Heading}" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StateDot" Width="18" Height="18" Fill="#1baf7a" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="StateTitle" Text="AutoFanatic controls your fans" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="StateDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="PauseButton" Grid.Column="2" Content="Pause" MinWidth="130" Padding="18,9" VerticalAlignment="Center"
                                    Style="{DynamicResource AccentButtonStyle}" />
                        </Grid>
                    </Border>

                    <UniformGrid Columns="3" Margin="-6,0,-6,6">
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="CpuTemp" Text="–" FontSize="34" FontWeight="SemiBold" />
                                <TextBlock x:Name="CpuPower" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="Graphics card" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="GpuTemp" Text="–" FontSize="34" FontWeight="SemiBold" />
                                <TextBlock x:Name="GpuPower" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="Limit" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="LimitValue" Text="–" FontSize="34" FontWeight="SemiBold" />
                                <TextBlock x:Name="LimitDetail" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Fans" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                            <StackPanel x:Name="FanRows" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Temperature limit" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,14"
                                       Text="The fans stay as quiet as possible while keeping CPU and GPU below this. Switching works the curves out again from your measurements; your own curves stay." />
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="Max80" Style="{StaticResource Choice}" Padding="20,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Max 80" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="cool and quiet" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="Max90" Style="{StaticResource Choice}" Padding="20,12">
                                    <StackPanel>
                                        <TextBlock Text="Max 90" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="as quiet as possible" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock x:Name="ProfileNote" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- fan curves -->
            <Grid x:Name="CurvesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Fan curves" Style="{StaticResource Heading}" />
                <WrapPanel x:Name="CurveTabs" Grid.Row="1" Margin="0,0,0,12" />
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CurveTitle" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="CurveSubtitle" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Ellipse Width="10" Height="10" x:Name="LegendUse" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="in use" Style="{StaticResource Caption}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <Rectangle Width="16" Height="2" x:Name="LegendRecommended" Margin="0,0,6,0" VerticalAlignment="Center" StrokeDashArray="2 2" StrokeThickness="2" />
                                <TextBlock Text="recommended" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <local:CurveEditor x:Name="Editor" Grid.Row="1" Margin="0,14" MinHeight="280" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox x:Name="AllowStop" Content="Switch off at idle while it's cool" />
                                <TextBlock x:Name="CurveHint" Style="{StaticResource Caption}" Margin="0,8,16,0"
                                           Text="Drag a point to change it · double-click to add a point · right-click a point to remove it. Changes apply right away; the safety limits always stay on." />
                            </StackPanel>
                            <Button x:Name="ResetCurve" Grid.Column="1" Content="Reset to recommended" Padding="16,9" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- settings -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource Heading}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="AutoFanatic starts when you log in, without an admin prompt (a Task Scheduler task)." />
                            </StackPanel>
                            <CheckBox x:Name="AutostartBox" Grid.Column="1" VerticalAlignment="Center" Content="On" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Calibration" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="CalibrationInfo" Style="{StaticResource Caption}" Margin="0,2,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="OpenPage" Content="Open the calibration page" Padding="16,9" Margin="0,0,10,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                       Text="To calibrate again: exit AutoFanatic (icon next to the clock → Exit), start Start-Test.cmd and choose 2 Calibrate. Every calibration adds to the ones before." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Data folder" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="DataPath" Style="{StaticResource Caption}" Margin="0,2,0,12" />
                            <Button x:Name="OpenFolder" Content="Open folder" Padding="16,9" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
