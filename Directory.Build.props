<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Product>AutoFantic</Product>
    <!-- the next release's version; a release build takes it from the git tag (v0.2.0 → 0.2.0),
         Start-Dev-Build.cmd adds "-dev" (0.2.0-dev) so a dev build is easy to tell apart -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <Copyright>Copyright (c) 2026 Ironnix · MIT License</Copyright>
  </PropertyGroup>
</Project>
