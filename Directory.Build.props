<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Product>AuFantic</Product>
    <!-- the next release's version; a release build takes it from the git tag (v0.1.8 → 0.1.8),
         Start-Dev-Build.cmd adds "-dev" (0.1.8-dev) so a dev build is easy to tell apart -->
    <VersionPrefix>0.2.3</VersionPrefix>
    <Copyright>Copyright (c) 2026 Ironnix · MIT License</Copyright>
  </PropertyGroup>
</Project>
